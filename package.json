{
  "name": "clippilot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.7.0",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "prisma generate && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "worker:dev": "tsx worker/src/index.ts",
    "worker:build": "tsc -p worker/tsconfig.json",
    "worker:start": "node worker/dist/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1041.0",
    "@aws-sdk/lib-storage": "^3.1041.0",
    "@aws-sdk/s3-request-presigner": "^3.1041.0",
    "@hookform/resolvers": "^5.2.2",
    "@playwright/test": "^1.59.1",
    "@prisma/client": "^6.9.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@stripe/stripe-js": "^9.4.0",
    "autoprefixer": "^10.5.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "ioredis": "^5.10.1",
    "lucide-react": "^1.14.0",
    "msgpackr": "^2.0.1",
    "nanoid": "^5.1.11",
    "next": "^15.5.15",
    "next-auth": "^5.0.0-beta.31",
    "postcss": "^8.5.13",
    "prisma": "^6.9.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.75.0",
    "sonner": "^2.0.7",
    "stripe": "^22.1.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.19",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.15",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^2.1.8"
